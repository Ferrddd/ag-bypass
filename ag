#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from core.config import Config
from core import network, system

C_CYAN, C_GREEN, C_YELLOW, C_RED, C_BOLD, C_RESET = (
    "\033[36m", "\033[32m", "\033[33m", "\033[31m", "\033[1m", "\033[0m"
)


def _req_admin(action: str):
    if not system.is_admin():
        if sys.platform == "win32":
            print(f"{C_RED}[!] Ошибка: Для команды '{action}' требуются права Администратора.{C_RESET}")
            print("    Запустите командную строку или PowerShell от имени Администратора.")
        else:
            print(f"{C_RED}[!] Ошибка: Для команды '{action}' требуются права root.{C_RESET}")
            print(f"    Запустите: {C_BOLD}sudo {sys.argv[0]} {action}{C_RESET}")
        sys.exit(1)


def _print_dns_results(res_info, indent="      "):
    for r in res_info.dns_results:
        srv = r["server"]
        if r["ips"]:
            ip_desc = f" ({r['dns_ip']})" if r["dns_ip"] and r["dns_ip"] != srv else ""
            print(f"{indent}{C_GREEN}[✓]{C_RESET} DNS {srv}{ip_desc}: получено {len(r['ips'])} IP ({', '.join(r['ips'])})")
        else:
            print(f"{indent}{C_YELLOW}[-]{C_RESET} DNS {srv}: {r['error']}")
    if res_info.config_nodes:
        print(f"{indent}{C_CYAN}[i]{C_RESET} Статические узлы: {', '.join(res_info.config_nodes)}")


def cmd_on(args, cfg: Config):
    _req_admin("on")

    if errs := cfg.validate():
        print(f"{C_RED}[!] Ошибка в конфигурации ({cfg.path}):{C_RESET}")
        for err in errs:
            print(f"    - {err}")
        sys.exit(1)

    # 1. Binary check & patch
    print(f"{C_BOLD}[1/5] Клиент Antigravity...{C_RESET}")
    if bp := system.find_binary(cfg.binary_path):
        st = system.get_binary_status(bp)
        if st == "READY_TO_PATCH":
            ok, msg = system.apply_patch(bp)
            print(f"      {C_GREEN if ok else C_RED}{msg}{C_RESET}")
        else:
            col = C_GREEN if st == "ALREADY_PATCHED" else C_YELLOW
            print(f"      Файл: {bp} (статус: {col}{st}{C_RESET})")
    else:
        print(f"      {C_YELLOW}[WARN] Бинарник не найден в стандартных путях.{C_RESET}")

    # 2. Endpoint
    print(f"{C_BOLD}[2/5] Настройка CLOUD_CODE_URL...{C_RESET}")
    applied = system.apply_endpoint(cfg.endpoint_url)
    print(
        f"      {C_GREEN}[✓] Применено ({cfg.endpoint_url}): {', '.join(applied)}{C_RESET}"
        if applied
        else f"      {C_YELLOW}[WARN] Не удалось записать файлы окружения.{C_RESET}"
    )

    # 3. DNS resolve & query / nodes
    dns_count = len(cfg.smart_dns_servers)
    dns_label = f" ({dns_count} серверов)" if dns_count > 1 else ""
    print(f"{C_BOLD}[3/5] Запрос IP через DNS{dns_label}...{C_RESET}")
    dom = cfg.domains[0]
    cands, res_info = network.get_candidate_ips(cfg, dom)
    _print_dns_results(res_info, indent="      ")

    if not cands:
        print(f"      {C_RED}[ERR] Не удалось получить адреса узлов: {res_info.summary}{C_RESET}")
        print(f"      {C_YELLOW}Укажите рабочие DNS-серверы в 'smart_dns.servers' или добавьте IP в 'nodes' в config.json{C_RESET}")
        sys.exit(1)
    print(f"      {C_GREEN}[✓]{C_RESET} Всего кандидатов для SNI-проверки: {C_BOLD}{len(cands)}{C_RESET}")

    # 4. Check & rank working SNI
    print(f"{C_BOLD}[4/5] TLS SNI-проверка узлов ({dom}:443)...{C_RESET}")
    all_results = network.check_all_ips(cands, dom, port=cfg.check_port, timeout=cfg.check_timeout)
    working = [r for r in all_results if r["ok"]]

    for r in all_results:
        tag = f"{C_GREEN}[SNI OK]{C_RESET}" if r["ok"] else f"{C_RED}[OFFLINE]{C_RESET}"
        lat = f"{r['latency_ms']:>6.1f} мс" if r["ok"] else "     -"
        print(f"      {tag} {r['ip']:<16} {lat} ({r['detail']})")

    if not working:
        print(f"      {C_RED}[ERR] Ни один из проверенных IP ({', '.join(cands)}) не ответил на TLS SNI-хэндшейк!{C_RESET}")
        sys.exit(1)

    best_ip, lat = working[0]["ip"], working[0]["latency_ms"]
    print(f"      {C_GREEN}[✓] Выбран лучший рабочий SNI: {best_ip} ({lat:.1f} мс){C_RESET}")

    # 5. Hosts
    print(f"{C_BOLD}[5/5] Маршрутизация ({system.DEFAULT_HOSTS_PATH})...{C_RESET}")
    ok, msg = system.set_entries([(best_ip, d) for d in cfg.domains])
    if not ok:
        print(f"      {C_RED}[ERR] {msg}{C_RESET}")
        sys.exit(1)
    print(f"      {C_GREEN}[✓] {best_ip} -> {', '.join(cfg.domains)} прописан в {system.DEFAULT_HOSTS_PATH}{C_RESET}")
    print(f"\n{C_GREEN}{C_BOLD}[✓] Обход активирован! Antigravity CLI готов к работе.{C_RESET}")


def cmd_off(args, cfg: Config):
    _req_admin("off")
    ok, msg = system.clear_entries()
    print(f"{C_GREEN}[✓] {msg}{C_RESET}" if ok else f"{C_RED}[ERR] {msg}{C_RESET}")
    rm = system.remove_endpoint()
    print(f"{C_GREEN}[✓] Удалены файлы окружения ({len(rm)}){C_RESET}" if rm else "    Файлы окружения не найдены.")
    if not ok:
        sys.exit(1)


def cmd_status(args, cfg: Config):
    bp = system.find_binary(cfg.binary_path)
    bst = system.get_binary_status(bp) if bp else "NOT_FOUND"
    has_ep, ep_desc = system.get_endpoint_status()
    entries = system.get_active_entries()

    node_info = None
    if entries:
        ip, dom = entries[0]
        alive, lat, detail = network.test_ip_with_retries(ip, dom, port=cfg.check_port, timeout=cfg.check_timeout, retries=1)
        safe_detail = detail.replace("\r", " ").replace("\n", " ").strip()
        node_info = {"ip": ip, "domain": dom, "alive": alive, "latency_ms": lat if alive else 0.0, "detail": safe_detail}

    timer = system.is_timer_active()

    print(f"{C_CYAN}{C_BOLD}=== Antigravity Bypass Status ==={C_RESET}")
    print(f"Конфигурация: {cfg.path}" + ("" if cfg.exists else f" {C_YELLOW}(файл не найден){C_RESET}"))
    bcol = C_GREEN if bst == "ALREADY_PATCHED" else C_YELLOW
    print(f"1. Клиент:    {bcol}{bst}{C_RESET}")
    print(f"2. Эндпоинт:  {C_GREEN if has_ep else C_YELLOW}{ep_desc}{C_RESET}")
    hdesc = f"{C_GREEN}АКТИВЕН ({', '.join(f'{i}->{d}' for i, d in entries)}){C_RESET}" if entries else f"{C_YELLOW}ОТКЛЮЧЕН{C_RESET}"
    print(f"3. Маршруты:  {hdesc}")
    if node_info:
        ncol = C_GREEN if node_info["alive"] else C_RED
        print(f"4. Узел {node_info['ip']}: {ncol}{'ДОСТУПЕН (SNI OK)' if node_info['alive'] else 'НЕ ОТВЕЧАЕТ'} ({node_info['latency_ms']:.1f} мс, {node_info['detail']}){C_RESET}")
    else:
        print(f"4. Узел:       {C_YELLOW}не выбран (обход отключен){C_RESET}")
    tcol = C_GREEN if timer else C_YELLOW
    print(f"5. Мониторинг: {tcol}{'АКТИВЕН (каждые ' + str(cfg.check_interval_minutes) + ' мин)' if timer else 'не запущен'}{C_RESET}")


def cmd_nodes(args, cfg: Config):
    if not cfg.domains:
        print(f"{C_RED}[ERR] Список доменов (domains) в конфигурации пуст.{C_RESET}")
        sys.exit(1)

    dom = cfg.domains[0]
    dns_count = len(cfg.smart_dns_servers)
    dns_label = f" ({dns_count} серверов)" if dns_count > 1 else ""
    print(f"{C_BOLD}Опрос DNS{dns_label} для домена {dom}...{C_RESET}")
    cands, res_info = network.get_candidate_ips(cfg, dom)
    _print_dns_results(res_info, indent="  ")

    active_ips = {ip for ip, _ in system.get_active_entries()}
    all_ips = list(dict.fromkeys(cands + list(active_ips)))

    if not all_ips:
        print(f"{C_RED}[ERR] Нет узлов для проверки: {res_info.summary}{C_RESET}")
        print(f"{C_YELLOW}Укажите DNS-серверы в 'smart_dns.servers' или добавьте IP в 'nodes' в config.json{C_RESET}")
        sys.exit(1)

    print(f"\n{C_BOLD}TLS SNI-проверка {len(all_ips)} узлов ({dom}:443):{C_RESET}\n")
    res = network.check_all_ips(all_ips, dom, port=cfg.check_port, timeout=cfg.check_timeout)

    print(f"{C_BOLD}{'IP':<18} {'SNI СТАТУС':<12} {'ОТКЛИК':<12} {'АКТИВЕН':<9} {'ДЕТАЛИ'}{C_RESET}\n" + "-" * 75)
    for r in res:
        st_text = f"{'ONLINE':<12}" if r["ok"] else f"{'OFFLINE':<12}"
        st = f"{C_GREEN}{st_text}{C_RESET}" if r["ok"] else f"{C_RED}{st_text}{C_RESET}"
        lat = f"{r['latency_ms']:.1f} мс" if r["ok"] else "-"
        act_text = f"{'* ДА':<9}" if r["ip"] in active_ips else f"{'  -':<9}"
        act = f"{C_CYAN}{act_text}{C_RESET}" if r["ip"] in active_ips else act_text
        raw_det = r["detail"].replace("\r", " ").replace("\n", " ").strip()
        det = raw_det[:27] + "..." if len(raw_det) > 30 else raw_det
        print(f"{r['ip']:<18} {st} {lat:<12} {act} {det}")


def cmd_check(args, cfg: Config):
    _req_admin("check")
    st, msg = network.check_and_heal(cfg, quiet=args.quiet)
    if not args.quiet:
        col = C_GREEN if st in ("HEALTHY", "HEALED") else C_YELLOW
        print(f"{col}[{st}] {msg}{C_RESET}")


def cmd_unpatch(args, cfg: Config):
    _req_admin("unpatch")
    bp = system.find_binary(cfg.binary_path)
    if not bp:
        sys.exit(f"{C_RED}[ERR] Бинарник не найден.{C_RESET}")
    ok, msg = system.restore_backup(bp)
    print(f"{C_GREEN if ok else C_RED}[{'✓' if ok else 'ERR'}] {msg}{C_RESET}")
    if not ok:
        sys.exit(1)


def main():
    base = argparse.ArgumentParser(add_help=False)
    base.add_argument("-c", "--config", default=argparse.SUPPRESS, help="Путь к файлу конфигурации JSON")

    p = argparse.ArgumentParser(description="Antigravity Bypass", parents=[base])
    sub = p.add_subparsers(dest="cmd")
    for name, help_text in [("on", "Включить обход"), ("off", "Выключить обход"), ("status", "Показать статус"), ("nodes", "Проверить все узлы"), ("unpatch", "Восстановить бинарник")]:
        sub.add_parser(name, parents=[base], help=help_text)

    chk = sub.add_parser("check", parents=[base], help="Проверить и обновить узел")
    chk.add_argument("-q", "--quiet", action="store_true", help="Тихий режим")

    args = p.parse_args()
    try:
        cfg = Config(getattr(args, "config", None))
    except Exception as e:
        print(f"{C_RED}[!] Ошибка конфигурации: {e}{C_RESET}")
        sys.exit(1)

    handlers = {
        "on": cmd_on, "off": cmd_off, "status": cmd_status,
        "check": cmd_check, "nodes": cmd_nodes, "unpatch": cmd_unpatch,
    }
    if fn := handlers.get(args.cmd or "status"):
        fn(args, cfg)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
