#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from core.config import Config
from core import checker, endpoint, hosts, monitor, patcher, resolver

C_CYAN, C_GREEN, C_YELLOW, C_RED, C_BOLD, C_RESET = (
    "\033[36m", "\033[32m", "\033[33m", "\033[31m", "\033[1m", "\033[0m"
)


def _req_root(action: str):
    if os.geteuid() != 0:
        print(f"{C_RED}[!] Ошибка: Для команды '{action}' требуются права root.{C_RESET}")
        print(f"    Запустите: {C_BOLD}sudo {sys.argv[0]} {action}{C_RESET}")
        sys.exit(1)


def cmd_on(args, cfg: Config):
    _req_root("on")
    # 1. Binary check & patch
    print(f"{C_BOLD}[1/5] Клиент Antigravity...{C_RESET}")
    if bp := patcher.find_binary(cfg.binary_path):
        st = patcher.get_status(bp)
        if st == "READY_TO_PATCH":
            ok, msg = patcher.apply_patch(bp)
            print(f"      {C_GREEN if ok else C_RED}{msg}{C_RESET}")
        else:
            col = C_GREEN if st == "ALREADY_PATCHED" else C_YELLOW
            print(f"      Файл: {bp} (статус: {col}{st}{C_RESET})")
        if patcher.is_binary_running(bp):
            print(f"      {C_YELLOW}[WARN] Процесс agy запущен. Перезапустите клиент.{C_RESET}")
    else:
        print(f"      {C_YELLOW}[WARN] Бинарник не найден в стандартных путях.{C_RESET}")

    # 2. Endpoint
    print(f"{C_BOLD}[2/5] Настройка CLOUD_CODE_URL...{C_RESET}")
    applied = endpoint.apply_endpoint()
    print(f"      {C_GREEN}[✓] Применено: {', '.join(applied)}{C_RESET}" if applied else f"      {C_YELLOW}[WARN] Не удалось записать файлы окружения.{C_RESET}")

    # 3. DNS resolve & query
    print(f"{C_BOLD}[3/5] Запрос IP через SmartDNS...{C_RESET}")
    dom = cfg.domains[0]
    dns_ip = resolver.resolve_dns_server(cfg.smart_dns_host, cfg.smart_dns_fallback_ip)
    cands = resolver.query_a_records(dns_ip, dom, port=cfg.smart_dns_port, timeout=cfg.smart_dns_timeout) or [
        "159.194.200.33", "193.233.112.67", "193.233.112.68", "193.233.112.88"
    ]
    print(f"      DNS {dns_ip} вернул: {', '.join(cands)}")

    # 4. Check & rank
    print(f"{C_BOLD}[4/5] TLS-проверка узлов...{C_RESET}")
    ranked = checker.rank_ips(cands, dom, port=cfg.check_port, timeout=cfg.check_timeout)
    if not ranked:
        print(f"      {C_RED}[ERR] Ни один из IP не ответил на TLS-хэндшейк!{C_RESET}")
        sys.exit(1)
    best_ip, lat = ranked[0]
    print(f"      {C_GREEN}[✓] Выбран лучший узел: {best_ip} ({lat:.1f} мс){C_RESET}")

    # 5. Hosts
    print(f"{C_BOLD}[5/5] Маршрутизация (/etc/hosts)...{C_RESET}")
    ok, msg = hosts.set_entries([(best_ip, d) for d in cfg.domains])
    if not ok:
        print(f"      {C_RED}[ERR] {msg}{C_RESET}")
        sys.exit(1)
    print(f"      {C_GREEN}[✓] {best_ip} -> {dom} прописан в /etc/hosts{C_RESET}")
    print(f"\n{C_GREEN}{C_BOLD}[✓] Обход активирован!{C_RESET}\n    Выполните: {C_BOLD}eval $({sys.argv[0]} env){C_RESET}")


def cmd_off(args, cfg: Config):
    _req_root("off")
    ok, msg = hosts.clear_entries()
    print(f"{C_GREEN}[✓] {msg}{C_RESET}" if ok else f"{C_RED}[ERR] {msg}{C_RESET}")
    rm = endpoint.remove_endpoint()
    print(f"{C_GREEN}[✓] Удалены файлы окружения ({len(rm)}){C_RESET}" if rm else "    Файлы окружения не найдены.")


def cmd_status(args, cfg: Config):
    bp = patcher.find_binary(cfg.binary_path)
    bst = patcher.get_status(bp) if bp else "NOT_FOUND"
    running = patcher.is_binary_running(bp) if bp else False
    pids = patcher.get_running_pids(bp) if bp else []
    has_ep, ep_desc = endpoint.get_status()
    entries = hosts.get_active_entries()

    node_info = None
    if entries:
        ip, dom = entries[0]
        alive, lat, detail = checker.test_ip_with_retries(ip, dom, port=cfg.check_port, retries=1)
        node_info = {"ip": ip, "domain": dom, "alive": alive, "latency_ms": lat if alive else 0.0, "detail": detail}

    timer = False
    try:
        timer = subprocess.run(["systemctl", "is-active", "ag-check.timer"], capture_output=True, text=True).stdout.strip() == "active"
    except Exception:
        pass

    if getattr(args, "json", False):
        print(json.dumps({
            "binary": {"path": str(bp) if bp else None, "status": bst, "running": running, "pids": pids},
            "endpoint": {"configured": has_ep, "detail": ep_desc},
            "hosts": {"active": bool(entries), "entries": [{"ip": i, "domain": d} for i, d in entries]},
            "active_node": node_info,
            "timer": {"active": timer, "interval_minutes": cfg.check_interval_minutes},
        }, indent=2, ensure_ascii=False))
        return

    print(f"{C_CYAN}{C_BOLD}=== Antigravity Bypass Status ==={C_RESET}")
    bcol = C_GREEN if bst == "ALREADY_PATCHED" else C_YELLOW
    print(f"1. Клиент:    {bcol}{bst}{C_RESET}" + (f" (PID: {', '.join(map(str, pids))})" if running else " (не запущен)"))
    print(f"2. Эндпоинт:  {C_GREEN if has_ep else C_YELLOW}{ep_desc}{C_RESET}")
    hdesc = f"{C_GREEN}АКТИВЕН ({', '.join(f'{i}->{d}' for i, d in entries)}){C_RESET}" if entries else f"{C_YELLOW}ОТКЛЮЧЕН{C_RESET}"
    print(f"3. Маршруты:  {hdesc}")
    if node_info:
        ncol = C_GREEN if node_info["alive"] else C_RED
        print(f"4. Узел {node_info['ip']}: {ncol}{'ДОСТУПЕН' if node_info['alive'] else 'НЕ ОТВЕЧАЕТ'} ({node_info['latency_ms']:.1f} мс, {node_info['detail']}){C_RESET}")
    tcol = C_GREEN if timer else C_YELLOW
    print(f"5. Мониторинг: {tcol}{'АКТИВЕН (каждые ' + str(cfg.check_interval_minutes) + ' мин)' if timer else 'не запущен'}{C_RESET}")


def cmd_nodes(args, cfg: Config):
    dom = cfg.domains[0]
    dns = resolver.resolve_dns_server(cfg.smart_dns_host, cfg.smart_dns_fallback_ip)
    cands = resolver.query_a_records(dns, dom, port=cfg.smart_dns_port, timeout=cfg.smart_dns_timeout) or [
        "159.194.200.33", "193.233.112.67", "193.233.112.68", "193.233.112.88"
    ]
    active_ips = {ip for ip, _ in hosts.get_active_entries()}
    all_ips = list(dict.fromkeys(cands + list(active_ips)))
    res = checker.check_all_ips(all_ips, dom, port=cfg.check_port, timeout=cfg.check_timeout)

    if getattr(args, "json", False):
        print(json.dumps([
            {"ip": r["ip"], "active": r["ip"] in active_ips, "alive": r["ok"], "latency_ms": r["latency_ms"], "detail": r["detail"]}
            for r in res
        ], indent=2, ensure_ascii=False))
        return

    print(f"{C_BOLD}{'IP':<18} {'СТАТУС':<10} {'ОТКЛИК':<12} {'АКТИВЕН':<9} {'ДЕТАЛИ'}{C_RESET}\n" + "-" * 75)
    for r in res:
        st = f"{C_GREEN}ONLINE{C_RESET}" if r["ok"] else f"{C_RED}OFFLINE{C_RESET}"
        lat = f"{r['latency_ms']:.1f} мс" if r["ok"] else "-"
        act = f"{C_CYAN}* ДА{C_RESET}" if r["ip"] in active_ips else "  -"
        det = r["detail"][:27] + "..." if len(r["detail"]) > 30 else r["detail"]
        print(f"{r['ip']:<18} {st:<19} {lat:<12} {act:<18} {det}")


def cmd_check(args, cfg: Config):
    _req_root("check")
    st, msg = monitor.check_and_heal(cfg, interactive=not args.quiet and not args.non_interactive, quiet=args.quiet)
    if not args.quiet:
        col = C_GREEN if st in ("HEALTHY", "HEALED") else C_YELLOW
        print(f"{col}[{st}] {msg}{C_RESET}")


def cmd_unpatch(args, cfg: Config):
    _req_root("unpatch")
    bp = patcher.find_binary(cfg.binary_path)
    if not bp:
        sys.exit(f"{C_RED}[ERR] Бинарник не найден.{C_RESET}")
    ok, msg = patcher.restore_backup(bp)
    print(f"{C_GREEN if ok else C_RED}[{'✓' if ok else 'ERR'}] {msg}{C_RESET}")


def main():
    p = argparse.ArgumentParser(description="Antigravity Linux Bypass")
    p.add_argument("-c", "--config", help="Путь к config.json")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("on", help="Включить обход")
    sub.add_parser("off", help="Выключить обход")
    st = sub.add_parser("status", help="Показать статус")
    st.add_argument("--json", action="store_true", help="Вывод в JSON")
    chk = sub.add_parser("check", help="Проверить и обновить узел")
    chk.add_argument("-q", "--quiet", action="store_true", help="Тихий режим")
    chk.add_argument("--non-interactive", action="store_true", help="Без интерактивных запросов")
    nd = sub.add_parser("nodes", help="Проверить все узлы")
    nd.add_argument("--json", action="store_true", help="Вывод в JSON")
    sub.add_parser("env", help="Команда экспорта CLOUD_CODE_URL")
    sub.add_parser("unpatch", help="Восстановить оригинальный бинарник")

    args = p.parse_args()
    cfg = Config(args.config)
    handlers = {
        "on": cmd_on, "off": cmd_off, "status": cmd_status,
        "check": cmd_check, "nodes": cmd_nodes,
        "env": lambda a, c: print(endpoint.get_export_command()),
        "unpatch": cmd_unpatch,
    }
    if fn := handlers.get(args.cmd or "status"):
        fn(args, cfg)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
